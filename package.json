{
	"name": "step-wise",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"api",
		"frontend",
		"shared/packages/*"
	],
	"scripts": {
		"build": "npm run build:packages && npm run build:frontend",
		"build:packages": "tsc -b tsconfig.json",
		"clean:packages": "rimraf --glob \"shared/packages/*/dist\"",
		"dev:api": "npm run dev --workspace=@step-wise/api",
		"dev:frontend": "npm start --workspace=@step-wise/frontend",
		"build:frontend": "npm run build --workspace=@step-wise/frontend",
		"rebuild:packages": "npm run clean:packages && npm run build:packages",
		"start:api": "npm start --workspace=@step-wise/api",
		"test": "npm run test:packages",
		"test:api": "npm test --workspace=@step-wise/api",
		"test:frontend": "npm test --workspace=@step-wise/frontend",
		"test:packages": "jest --config shared/jest.config.js",
		"test:packages:watch": "jest --config shared/jest.config.js --watch",
		"watch:packages": "npm run clean:packages && tsc -b tsconfig.json --watch"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"jest": "^29.7.0",
		"rimraf": "^6.1.3",
		"ts-jest": "^29.4.9",
		"typescript": "^6.0.2"
	}
}
