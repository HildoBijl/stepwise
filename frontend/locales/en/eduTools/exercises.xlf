						<source>Check submissions</source>
					</segment>
				</unit>
				<unit id="confirmGivingUp">
					<segment>
						<source>Confirm giving up</source>
					</segment>
				</unit>
				<unit id="newGroupExercise">
					<segment>
						<source>Open latest exercise</source>
					</segment>
				</unit>
				<unit id="confirmSolvingStepWise">
					<segment>
						<source>Confirm solving Step-Wise</source>
					</segment>
				</unit>
			</group>
			<unit id="unequalSolutionWarning">
				<segment>
					<source>The above input is not equal to your submitted solution.</source>
				</segment>
			</unit>
			<unit id="notEnoughSubmissions">
				<segment>
					<source>When practicing together, at least two submissions are needed to complete an exercise. Invite a fellow student.</source>
				</segment>
			</unit>
		</group>
