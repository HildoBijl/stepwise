				<segment>
					<source>The exercise failed to load. Please check if the exercise ID is correct.</source>
				</segment>
			</unit>
			<unit id="loadingExercise">
				<segment>
					<source>Loading the exercise...</source>
				</segment>
			</unit>
		</group>
		<group id="stepsModal">
			<unit id="title">
				<segment>
					<source>Are you sure?</source>
				</segment>
			</unit>
			<unit id="message">
				<segment>
					<source>The goal of Step-Wise is that you can eventually solve exercises without using steps. If you give up without trying, then this counts as an incorrect submission. Your skill rating will decrease.</source>
				</segment>
			</unit>
			<group id="buttons">
				<unit id="no">
					<segment>
						<source>Not yet ...</source>
					</segment>
				</unit>
				<unit id="yes">
					<segment>
						<source>Show me the steps</source>
					</segment>
				</unit>
			</group>
		</group>
		<group id="buttons">
			<unit id="giveUp">
				<segment>
					<source>I give up</source>
				</segment>
			</unit>
			<unit id="check">
				<segment>
					<source>Submit and check</source>
				</segment>
			</unit>
			<unit id="solveStepWise">
				<segment>
					<source>Solve this Step-Wise</source>
				</segment>
			</unit>
			<unit id="giveUpStep">
				<segment>
					<source>I give up this step</source>
				</segment>
			</unit>
			<unit id="nextExercise">
				<segment>
					<source>Next exercise</source>
				</segment>
			</unit>
			<unit id="solve">
				<segment>
					<source>Insert solution</source>
				</segment>
			</unit>
			<group id="stepSelect">
				<unit id="tryMain">
					<segment>
						<source>Try the main exercise</source>
					</segment>
				</unit>
				<unit id="tryStep">
					<segment>
						<source>Try out step <ph id="x1" type="ui" subType="xlf:var" swi18n:name="step"/></source>
					</segment>
				</unit>
			</group>
			<unit id="showSteps">
				<segment>
					<source>Show steps</source>
				</segment>
			</unit>
		</group>
		<group id="groupExercise">
			<group id="status">
				<unit id="submitted">
					<segment>
						<source>Submitted:</source>
					</segment>
				</unit>
				<unit id="missingSubmissions">
					<segment>
						<source>Missing:</source>
					</segment>
				</unit>
				<unit id="givenUp">
					<segment>
						<source>Given up:</source>
					</segment>
				</unit>
				<unit id="solveStepWise">
					<segment>
						<source>Solve Step-Wise:</source>
					</segment>
				</unit>
				<unit id="submissionsReceived">
