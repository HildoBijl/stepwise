	<file id="catalog">
		<unit id="example">
			<segment>
				<source>Example exercise</source>
			</segment>
		</unit>
		<unit id="exercise">
			<segment>
				<source>Practice exercise</source>
			</segment>
		</unit>
		<unit id="solution">
			<segment>
				<source>Solution</source>
			</segment>
		</unit>
		<unit id="step">
			<segment>
				<source>Step <ph id="x1" type="ui" subType="xlf:var" swi18n:name="step"/></source>
			</segment>
		</unit>
		<group id="loadingNotes">
