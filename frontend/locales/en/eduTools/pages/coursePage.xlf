					<source>Prior knowledge</source>
				</segment>
			</unit>
			<unit id="gradeEstimate">
				<segment>
					<source>Based on your practice so far, we expect a score of roughly <pc id="c1" type="ui" subType="swi18n:strong" swi18n:slot="children"><ph id="x1" type="ui" subType="xlf:var" swi18n:name="percentage"/></pc> (about <pc id="c2" type="ui" subType="swi18n:strong" swi18n:slot="children"><ph id="x2" type="ui" subType="xlf:var" swi18n:name="lowerPercentage"/> - <ph id="x3" type="ui" subType="xlf:var" swi18n:name="upperPercentage"/></pc>) on the final test.</source>
				</segment>
			</unit>
			<unit id="disclaimer">
				<segment>
					<source>No rights can be derived from this estimate.</source>
				</segment>
			</unit>
			<unit id="practiceRecommendation">
