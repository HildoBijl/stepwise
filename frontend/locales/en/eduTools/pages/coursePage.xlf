				</segment>
			</unit>
		</group>
		<group id="teachers">
			<unit id="noStudents">
				<segment>
					<source><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">Your course is ready, but there are no students yet. Share the <pc id="c2" type="ui" subType="swi18n:link" swi18n:slot="children">course link</pc> (this page's URL) with students, or ask them to <pc id="c3" type="ui" subType="swi18n:link" swi18n:slot="children">add the course</pc> from the full list.</pc><pc id="c4" type="ui" subType="swi18n:par" swi18n:slot="children">For further options, check out the <pc id="c5" type="ui" subType="swi18n:link" swi18n:slot="children">Course Settings</pc> (top right).</pc></source>
				</segment>
			</unit>
