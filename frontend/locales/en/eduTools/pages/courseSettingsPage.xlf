						<source>None selected</source>
					</segment>
				</unit>
				<unit id="note">
					<segment>
						<source>Adding a teacher will grant them access to the work and progress of all students within this course.</source>
					</segment>
				</unit>
				<unit id="button">
					<segment>
						<source>Add <ph id="x1" type="ui" subType="xlf:var" swi18n:name="name"/> as teacher</source>
					</segment>
				</unit>
			</group>
			<group id="unsubscribe">
				<unit id="title">
					<segment>
						<source>Unsubscribe</source>
					</segment>
				</unit>
				<unit id="description">
					<segment>
						<source><pc id="x1" type="other" subType="swi18n:condition" swi18n:variable="$condition1"><pc id="x2" type="other" subType="swi18n:condition-true">By removing yourself from this course, you revoke your teacher access.</pc><pc id="x3" type="other" subType="swi18n:condition-false">You are a student in this course, but you see this teacher page due to your admin rights. You can unsubscribe as a student from this course.</pc></pc></source>
					</segment>
				</unit>
			</group>
			<group id="adminSubscribe">
				<unit id="title">
					<segment>
						<source>Subscribe</source>
					</segment>
				</unit>
				<unit id="description">
					<segment>
						<source>You're currently not a part of this course, but you are using your admin rights to peek in. Want to formally subscribe? Do so here.</source>
					</segment>
				</unit>
			</group>
		</group>
