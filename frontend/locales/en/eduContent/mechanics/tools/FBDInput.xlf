					<source><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">There are still missing arrows.</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">There is still a missing arrow.</pc></pc><pc id="x4" type="other" subType="swi18n:condition" swi18n:variable="$condition1"><pc id="x5" type="other" subType="swi18n:condition-true"> Have another look at point <ph id="x6" type="ui" subType="xlf:var" swi18n:name="pointName"/>.</pc><pc id="x7" type="other" subType="swi18n:condition-false"></pc></pc></source>
