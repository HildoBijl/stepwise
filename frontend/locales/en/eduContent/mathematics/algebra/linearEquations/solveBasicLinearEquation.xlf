							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">Both sides of the equation still contain <ph id="c2" type="ui" subType="swi18n:inline-math"/>. Pull all terms with <ph id="c3" type="ui" subType="swi18n:inline-math"/> to the <pc id="c4" type="ui" subType="swi18n:em" swi18n:slot="children">same</pc> side.</pc></source>
						</segment>
					</unit>
					<unit id="missingVariable">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">Your solution does not contain <ph id="c2" type="ui" subType="swi18n:inline-math"/>. Where did it go?</pc></source>
						</segment>
					</unit>
					<unit id="oneVariable">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">There were multiple terms with <ph id="c2" type="ui" subType="swi18n:inline-math"/>, but you only wrote down one.</pc></source>
						</segment>
					</unit>
					<unit id="termWithoutVariable">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">You did bring all terms with <ph id="c2" type="ui" subType="swi18n:inline-math"/> to one side, but there's also a term <ph id="c3" type="ui" subType="swi18n:inline-math"/> that does not contain <ph id="c4" type="ui" subType="swi18n:inline-math"/>.</pc></source>
						</segment>
					</unit>
					<unit id="noSideWithoutVariable">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">You put the variable <ph id="c2" type="ui" subType="swi18n:inline-math"/> on both sides of the equation again. That was not supposed to happen.</pc></source>
						</segment>
					</unit>
					<unit id="unequalSideWithoutVariable">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">The side without <ph id="c2" type="ui" subType="swi18n:inline-math"/> should remain the same!</pc></source>
						</segment>
					</unit>
					<unit id="disappearedVariable">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">You somehow let <ph id="c2" type="ui" subType="swi18n:inline-math"/> disappear entirely. That was not supposed to happen.</pc></source>
						</segment>
					</unit>
					<unit id="unequalSide">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">The side with <ph id="c2" type="ui" subType="swi18n:inline-math"/> is not equal to what it was before. Something went wrong during the rewriting.</pc></source>
						</segment>
					</unit>
					<unit id="notOutsideOfBrackets">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:a" swi18n:slot="children">You did not pull <ph id="c2" type="ui" subType="swi18n:inline-math"/> outside of brackets. You should write the side containing <ph id="c3" type="ui" subType="swi18n:inline-math"/> as <ph id="c4" type="ui" subType="swi18n:inline-math"/>, with on the dots an expression that's as simple as possible.</pc></source>
						</segment>
					</unit>
				</group>
			</group>
