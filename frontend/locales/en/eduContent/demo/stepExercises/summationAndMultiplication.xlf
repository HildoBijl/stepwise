						</segment>
					</unit>
				</group>
				<group id="step2">
					<unit id="problem">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">Calculate the multiplications.</pc><pc id="c2" type="ui" subType="swi18n:input-space" swi18n:slot="children"><pc id="c3" type="ui" subType="swi18n:par" swi18n:slot="children"><pc id="c4" type="ui" subType="swi18n:substep" swi18n:slot="children"><pc id="c5" type="ui" subType="swi18n:integer-input"><pc id="x1" type="other" subType="swi18n:slot" swi18n:name="label">Step answer</pc><pc id="x2" type="other" subType="swi18n:slot" swi18n:name="prelabel"><ph id="c6" type="ui" subType="swi18n:inline-math"/></pc></pc></pc><pc id="c7" type="ui" subType="swi18n:substep" swi18n:slot="children"><pc id="c8" type="ui" subType="swi18n:integer-input"><pc id="x3" type="other" subType="swi18n:slot" swi18n:name="label">Step answer</pc><pc id="x4" type="other" subType="swi18n:slot" swi18n:name="prelabel"><ph id="c9" type="ui" subType="swi18n:inline-math"/></pc></pc></pc></pc></pc></source>
						</segment>
					</unit>
					<unit id="solution">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">The results of the multiplications are <ph id="c2" type="ui" subType="swi18n:inline-math"/> and <ph id="c3" type="ui" subType="swi18n:inline-math"/>.</pc></source>
						</segment>
					</unit>
				</group>
