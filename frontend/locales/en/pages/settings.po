#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.button"
msgstr "Delete account"

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.confirmation"
msgstr "Are you sure you wish to delete your account? Then enter your email address below as confirmation."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.email"
msgstr "Email address"

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.explanation"
msgstr "If you delete your account, then <strong>all</strong> your data on Step-Wise will be erased. This cannot be undone. Of course you can create a new account afterwards, but this account will start from zero."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.invalidEmail"
msgstr "Failed to delete account. This email address is not coupled to your account."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.success"
msgstr "Your account has been deleted. You will be sent back to the home page."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.title"
msgstr "Delete account"

#. js-lingui-explicit-id
#: src/ui/pages/Settings/index.js
msgid "settings.introduction"
msgstr "You are signed in as {name} <{email}>."

