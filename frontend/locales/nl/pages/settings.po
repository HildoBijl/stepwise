#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.button"
msgstr "Verwijder account"

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.confirmation"
msgstr "Weet je zeker dat je je account wilt verwijderen? Vul dan hieronder ter bevestiging je emailadres in."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.email"
msgstr "Emailadres"

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.explanation"
msgstr "Als je je account verwijdert, dan worden <strong>alle</strong> gegevens van je op Step-Wise gewist. Dit kan niet ongedaan gemaakt worden! Je kunt daarna uiteraard wel een volledig nieuwe account aanmaken, maar deze begint weer vanaf nul."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.invalidEmail"
msgstr "Niet gelukt. Dit emailadres is niet gekoppeld aan je account."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.success"
msgstr "Gelukt. Het account is verwijderd. Je wordt doorgestuurd."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.title"
msgstr "Account verwijderen"

