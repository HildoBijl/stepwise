	<file id="catalog">
		<unit id="head">
			<segment>
				<source>How does it work?</source>
				<target swi18n:sourceContentFingerprint="1a1dee1328d05d6a" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Hoe werkt het?</target>
			</segment>
		</unit>
		<unit id="step1">
			<segment>
				<source>You practice exercises in the web-app.</source>
				<target swi18n:sourceContentFingerprint="f3292d15125b5a67" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Jij maakt oefenopgaven in de web-app.</target>
			</segment>
		</unit>
		<unit id="step2">
			<segment>
				<source>Every exercise gives you detailed feedback.</source>
				<target swi18n:sourceContentFingerprint="e8d714ed246cdaab" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Elke opgave geeft je gedetailleerde feedback.</target>
			</segment>
		</unit>
		<unit id="step3">
			<segment>
				<source>The app tracks what you're struggling with.</source>
				<target swi18n:sourceContentFingerprint="36f3541ca68d65f1" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">De app houdt bij waar je moeite mee hebt.</target>
			</segment>
		</unit>
		<unit id="step4">
			<segment>
				<source>You get more exercises on your level.</source>
				<target swi18n:sourceContentFingerprint="dbafbf4dc59b1b27" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Je krijgt op jouw niveau nieuwe opgaven.</target>
			</segment>
		</unit>
		<unit id="description">
			<segment>
				<source>Step-Wise is a free tutoring web-app that brushes up your mathematics, physics and/or mechanics skills to (pre-)university level.</source>
				<target swi18n:sourceContentFingerprint="12d38987553eb7bc" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Step-Wise is een gratis bijles-web-app waarmee je je wiskunde-, natuurkunde- en mechanicavaardigheden kan bijspijkeren tot (pre-)universiteitsniveau.</target>
			</segment>
		</unit>
