					<unit id="solution">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">In the end we add everything together. This get us the final result <ph id="c2" type="ui" subType="swi18n:inline-math"/>.</pc></source>
							<target swi18n:sourceContentFingerprint="34782260a0770088" swi18n:sourceStructureFingerprint="b25dc440c6e288ab"><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">Ten slotte tellen we alles bij elkaar op. Hiermee vinden we het eindantwoord <ph id="c2" type="ui" subType="swi18n:inline-math"/>.</pc></target>
						</segment>
					</unit>
