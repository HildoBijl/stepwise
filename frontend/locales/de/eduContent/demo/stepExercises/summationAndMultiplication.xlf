					<unit id="solution">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">In the end we add everything together. This get us the final result <ph id="c2" type="ui" subType="swi18n:inline-math"/>.</pc></source>
							<target swi18n:sourceContentFingerprint="34782260a0770088" swi18n:sourceStructureFingerprint="b25dc440c6e288ab"><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">Schließlich addieren wir alles zusammen. Auf diese Weise erhalten wir die endgültige Antwort <ph id="c2" type="ui" subType="swi18n:inline-math"/>.</pc></target>
						</segment>
					</unit>
				</group>
				<group id="feedback">
					<group id="order">
						<unit id="incorrect">
							<segment>
								<source>That's not correct. Addition always comes last. (Unless it's prioritized by brackets, which is not the case here.)</source>
								<target swi18n:sourceContentFingerprint="3303722b14b2658e" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Das ist nicht richtig. Die Addition kommt immer zuletzt. (Es sei denn, sie wird durch Klammern hervorgehoben, aber das ist hier nicht der Fall.)</target>
							</segment>
						</unit>
						<unit id="correct">
							<segment>
								<source>Yes! Multiplication indeed comes first.</source>
								<target swi18n:sourceContentFingerprint="5cab3513e325a444" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Genau! Die Multiplikation hat tatsächlich Vorrang.</target>
							</segment>
						</unit>
					</group>
