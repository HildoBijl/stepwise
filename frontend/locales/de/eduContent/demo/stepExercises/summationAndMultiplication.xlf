							<source><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">The results of the multiplications are <ph id="c2" type="ui" subType="swi18n:inline-math"/> and <ph id="c3" type="ui" subType="swi18n:inline-math"/>.</pc></source>
							<target swi18n:sourceContentFingerprint="8136320804a4e776" swi18n:sourceStructureFingerprint="2519d6521c612811"><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">Die Ergebnisse der Multiplikationen sind <ph id="c2" type="ui" subType="swi18n:inline-math"/>.</pc></target>
