					<unit id="problem">
						<segment>
							<source><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">Calculate the addition.</pc><pc id="c2" type="ui" subType="swi18n:input-space" swi18n:slot="children"><pc id="c3" type="ui" subType="swi18n:par" swi18n:slot="children"><pc id="c4" type="ui" subType="swi18n:integer-input"><pc id="x1" type="other" subType="swi18n:slot" swi18n:name="label">Final answer</pc><pc id="x2" type="other" subType="swi18n:slot" swi18n:name="prelabel"><ph id="c5" type="ui" subType="swi18n:inline-math"/></pc></pc></pc></pc></source>
							<target swi18n:sourceContentFingerprint="8af30eb21de6bcf7" swi18n:sourceStructureFingerprint="b78ead6af00bbe5e"><pc id="c1" type="ui" subType="swi18n:par" swi18n:slot="children">Berechne die Addition.</pc><pc id="c2" type="ui" subType="swi18n:input-space" swi18n:slot="children"><pc id="c3" type="ui" subType="swi18n:par" swi18n:slot="children"><pc id="c4" type="ui" subType="swi18n:integer-input"><pc id="x1" type="other" subType="swi18n:slot" swi18n:name="label">Endgültige Antwort</pc><pc id="x2" type="other" subType="swi18n:slot" swi18n:name="prelabel"><ph id="c5" type="ui" subType="swi18n:inline-math"/></pc></pc></pc></pc></target>
