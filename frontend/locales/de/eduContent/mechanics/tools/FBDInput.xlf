	<file id="catalog">
		<group id="feedback">
			<unit id="doubleArrows">
				<segment>
					<source>Some arrows have been drawn multiple times. Make sure that all arrows are unique.</source>
					<target swi18n:sourceContentFingerprint="b76b2fbba4270588" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Einige Pfeile sind doppelt gezeichnet. Achte darauf, dass alle Pfeile eindeutig sind.</target>
				</segment>
			</unit>
			<unit id="unconnectedLoads">
				<segment>
					<source><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">There are arrows that are</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">There is an arrow that is</pc></pc> not connected to any known point, so this can never be a correct solution.</source>
					<target swi18n:sourceContentFingerprint="c773f4ff2e3c354f" swi18n:sourceStructureFingerprint="c4e5728cb0b78448"><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">Es gibt Pfeile, die nicht mit einem bekannten Punkt verbunden sind.</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">Es gibt einen Pfeil, der nicht mit einem bekannten Punkt verbunden ist.</pc></pc> Dies kann also niemals eine richtige Antwort sein.</target>
				</segment>
			</unit>
			<unit id="missingLoads">
				<segment>
					<source><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">There are still missing arrows.</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">There is still a missing arrow.</pc></pc><pc id="x4" type="other" subType="swi18n:condition" swi18n:variable="$condition1"><pc id="x5" type="other" subType="swi18n:condition-true"> Have another look at point <ph id="x6" type="ui" subType="xlf:var" swi18n:name="pointName"/>.</pc><pc id="x7" type="other" subType="swi18n:condition-false"></pc></pc></source>
					<target swi18n:sourceContentFingerprint="9e6725fbdf8dde24" swi18n:sourceStructureFingerprint="9e683b8e0e70cf43"><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">Es fehlen noch Pfeile.</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">Es fehlt noch ein Pfeil.</pc></pc><pc id="x4" type="other" subType="swi18n:condition" swi18n:variable="$condition1"><pc id="x5" type="other" subType="swi18n:condition-true"> Schau dir Punkt <ph id="x6" type="ui" subType="xlf:var" swi18n:name="pointName"/> genau an.</pc><pc id="x7" type="other" subType="swi18n:condition-false"></pc></pc></target>
				</segment>
			</unit>
			<unit id="incorrectInputLoads">
				<segment>
					<source><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">There are <ph id="c1" type="ui" subType="swi18n:counting-word"/> arrows that should not be present.</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">An arrow has been drawn that shouldn't be present.</pc></pc> Have a look at that first.</source>
					<target swi18n:sourceContentFingerprint="1bf18f8ad647b328" swi18n:sourceStructureFingerprint="3f3297ad1144f01c"><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">Es sind <ph id="c1" type="ui" subType="swi18n:counting-word"/> Pfeile eingezeichnet, die nicht vorhanden sein sollten.</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">Es wurde ein Pfeil gezeichnet, der dort nicht sein sollte.</pc></pc> Schau dir das zuerst an.</target>
				</segment>
			</unit>
			<unit id="doubleInputLoads">
				<segment>
					<source><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">There are <ph id="c1" type="ui" subType="swi18n:counting-word"/> sets</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">There is a set</pc></pc> Remove the superfluous ones.</source>
					<target swi18n:sourceContentFingerprint="3af6547f9f71a48d" swi18n:sourceStructureFingerprint="3f3297ad1144f01c"><pc id="x1" type="other" subType="swi18n:plural" swi18n:variable="$plural1" swi18n:form="cardinal"><pc id="x2" type="other" subType="swi18n:plural-other">Es gibt <ph id="c1" type="ui" subType="swi18n:counting-word"/> Gruppen</pc><pc id="x3" type="other" subType="swi18n:plural-exact" swi18n:value="1">Es gibt eine Gruppe</pc></pc> Entferne unnötige Pfeile.</target>
				</segment>
			</unit>
		</group>
	</file>
