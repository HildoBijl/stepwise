#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.button"
msgstr "Konto löschen"

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.confirmation"
msgstr "Bist du sicher, dass du dein Konto löschen möchtest? Dann gib deine E-Mail-Adresse zur Bestätigung unten ein."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.email"
msgstr "E-Mail-Adresse"

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.explanation"
msgstr "Wenn du dein Konto löschst, werden <strong>alle</strong> deiner Daten auf Step-Wise gelöscht. Dies kann nicht rückgängig gemacht werden! Natürlich kannst du danach ein komplett neues Konto erstellen, aber das fängt dann wieder bei Null an."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.invalidEmail"
msgstr "Fehlgeschlagen. Diese E-Mail-Adresse ist nicht mit Ihrem Konto verbunden."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.success"
msgstr "Erfolgreich. Das Konto wurde gelöscht. Du wirst weitergeleitet."

#. js-lingui-explicit-id
#: src/ui/pages/Settings/DeleteAccount.js
msgid "settings.deleteAccount.title"
msgstr "Konto löschen"

#. js-lingui-explicit-id
