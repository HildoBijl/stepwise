					<target swi18n:sourceContentFingerprint="dc10f29075effdf3" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Sofort anfangen</target>
				</segment>
			</unit>
			<unit id="description">
				<segment>
					<source>Sign in to directly start practicing.</source>
					<target swi18n:sourceContentFingerprint="b015fb1d393034d3" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Melde dich an, um sofort zu üben.</target>
				</segment>
