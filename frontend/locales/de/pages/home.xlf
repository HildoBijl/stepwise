	<file id="catalog">
		<unit id="head">
			<segment>
				<source>How does it work?</source>
				<target swi18n:sourceContentFingerprint="1a1dee1328d05d6a" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Wie funktioniert es?</target>
			</segment>
		</unit>
		<unit id="step1">
			<segment>
				<source>You practice exercises in the web-app.</source>
				<target swi18n:sourceContentFingerprint="f3292d15125b5a67" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Du machst Übungsaufgaben in der Web-App.</target>
			</segment>
		</unit>
		<unit id="step2">
			<segment>
				<source>Every exercise gives you detailed feedback.</source>
				<target swi18n:sourceContentFingerprint="e8d714ed246cdaab" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Zu jeder Übung erhältst du ein ausführliches Feedback.</target>
			</segment>
		</unit>
		<unit id="step3">
			<segment>
				<source>The app tracks what you're struggling with.</source>
				<target swi18n:sourceContentFingerprint="36f3541ca68d65f1" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Die App merkt sich, womit du Probleme hast.</target>
			</segment>
		</unit>
		<unit id="step4">
			<segment>
				<source>You get more exercises on your level.</source>
				<target swi18n:sourceContentFingerprint="dbafbf4dc59b1b27" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Du bekommst neue Aufgaben auf deinem Niveau.</target>
			</segment>
		</unit>
		<unit id="description">
			<segment>
				<source>Step-Wise is a free tutoring web-app that brushes up your mathematics, physics and/or mechanics skills to (pre-)university level.</source>
				<target swi18n:sourceContentFingerprint="12d38987553eb7bc" swi18n:sourceStructureFingerprint="5ecb3f106fbb7f40">Step-Wise ist eine kostenlose Nachhilfe-Web-App, mit der du deine Mathematik-, Physik- und/oder Mechanikfähigkeiten auf (Vor-)Universitätsniveau auffrischen kannst.</target>
			</segment>
		</unit>
