FROM node:22-alpine AS workspace-build
WORKDIR /app

COPY package.json package-lock.json ./
COPY . .
RUN npm ci --quiet --no-audit --no-fund
RUN npm run build:packages

FROM workspace-build AS frontend-build
WORKDIR /app/frontend

# Declare build args
ARG VITE_API_ADDRESS
ARG VITE_API_WEBSOCKET_ENDPOINT
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_REDIRECT_ADDRESS

ENV VITE_API_ADDRESS=$VITE_API_ADDRESS
ENV VITE_API_WEBSOCKET_ENDPOINT=$VITE_API_WEBSOCKET_ENDPOINT
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
ENV VITE_GOOGLE_REDIRECT_ADDRESS=$VITE_GOOGLE_REDIRECT_ADDRESS

RUN npm run build
