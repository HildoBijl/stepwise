{
  "compilerOptions": {
    "paths": {
      "@step-wise/*": ["./packages/*/src"]
    },
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "target": "es2023",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "exclude": ["**/*.test.ts", "**/*.spec.ts"]
}
