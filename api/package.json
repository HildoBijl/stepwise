{
	"name": "@step-wise/api",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tsx scripts/startWebserver.ts",
		"dev": "tsx watch --clear-screen=false scripts/startWebserver.ts",
		"build": "npm run clean && tsc -p tsconfig.json",
		"clean": "rimraf dist",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
		"test": "cross-env POSTGRES_DB=\"testing\" jest --runInBand tests/.*\\.test\\.ts",
		"test:watch": "cross-env POSTGRES_DB=\"testing\" jest --watch --runInBand tests/integration/graphql/.*\\.test\\.ts",
		"db:seed": "tsx scripts/seedDatabase.ts",
		"db:clear": "tsx scripts/clearDatabase.ts",
		"db:migrate": "tsx scripts/migrateDatabase.ts"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@graphql-tools/schema": "^10.1.0",
		"@step-wise/course-definition": "1.0.0",
		"@step-wise/exercise-definition": "1.0.0",
		"@step-wise/exercise-selection": "1.0.0",
		"@step-wise/exercises": "1.0.0",
		"@step-wise/settings": "1.0.0",
		"@step-wise/skill-definition": "1.0.0",
		"@step-wise/skill-setup": "1.0.0",
		"@step-wise/skill-tracking": "1.0.0",
		"@step-wise/skill-tree": "1.0.0",
		"@step-wise/utils": "1.0.0",
		"body-parser": "^2.2.0",
		"connect-redis": "^10.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dataloader": "^2.2.3",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"google-auth-library": "^7.14.0",
		"graphql": "^16.14.2",
		"graphql-scalars": "^1.26.0",
		"graphql-subscriptions": "^3.0.0",
		"graphql-tag": "^2.12.7",
		"graphql-ws": "^6.2.1",
		"openid-client": "^4.9.1",
		"pg": "^8.23.0",
		"redis": "^6.2.1",
		"sequelize": "^6.28.0",
		"umzug": "^3.8.3",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@step-wise/input-interpretation": "1.0.0",
		"@step-wise/serialization": "1.0.0",
		"@swc/core": "^1.13.0",
		"@swc/jest": "^0.2.39",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^24.0.0",
		"@types/supertest": "^7.2.1",
		"@types/ws": "^8.18.1",
		"cross-env": "^10.1.0",
		"jest": "^30.4.2",
		"rimraf": "^6.1.3",
		"supertest": "^6.2.2",
		"tsx": "^4.20.0",
		"typescript": "^6.0.2"
	},
	"jest": {
		"verbose": false,
		"globalSetup": "<rootDir>/tests/globalSetup.ts",
		"transform": {
			"^.+\\.tsx?$": [
				"@swc/jest",
				{
					"jsc": {
						"parser": {
							"syntax": "typescript"
						},
						"target": "es2020"
					},
					"module": {
						"type": "commonjs"
					}
				}
			]
		}
	}
}
