{
	"name": "@step-wise/api",
	"version": "1.0.0",
	"engines": {
		"node": ">=24.12.0"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"start": "tsx scripts/startWebserver.ts",
		"dev": "tsx watch --clear-screen=false scripts/startWebserver.ts",
		"build": "npm run clean && tsc -p tsconfig.json",
		"clean": "rimraf dist",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json",
		"test": "vitest run --configLoader runner --config vitest.config.ts",
		"test:unit": "vitest run --configLoader runner --config vitest.unit.config.ts",
		"test:integration": "vitest run --configLoader runner --config vitest.config.ts tests/integration",
		"test:watch": "vitest --configLoader runner --config vitest.config.ts tests/integration/graphql",
		"db:clear": "tsx scripts/clearDatabase.ts",
		"db:migrate": "tsx scripts/migrateDatabase.ts"
	},
	"dependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/express5": "^1.1.2",
		"@graphql-tools/schema": "^10.1.0",
		"@graphql-tools/utils": "^12.0.0",
		"@step-wise/course-definition": "1.0.0",
		"@step-wise/exercise-definition": "1.0.0",
		"@step-wise/exercise-selection": "1.0.0",
		"@step-wise/exercises": "1.0.0",
		"@step-wise/js-utils": "1.0.0",
		"@step-wise/settings": "1.0.0",
		"@step-wise/skill-definition": "1.0.0",
		"@step-wise/skill-setup": "1.0.0",
		"@step-wise/skill-tracking": "1.0.0",
		"@step-wise/skill-tree": "1.0.0",
		"body-parser": "^2.2.0",
		"connect-redis": "^10.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dataloader": "^2.2.3",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"google-auth-library": "^11.0.2",
		"graphql": "^16.14.2",
		"graphql-scalars": "^1.26.0",
		"graphql-subscriptions": "^3.0.0",
		"graphql-tag": "^2.12.7",
		"graphql-ws": "^6.2.1",
		"openid-client": "^4.9.1",
		"pg": "^8.23.0",
		"redis": "^6.2.1",
		"sequelize": "^6.28.0",
		"umzug": "^3.8.3",
		"ws": "^8.18.3"
	},
	"devDependencies": {
		"@step-wise/input-interpretation": "1.0.0",
		"@step-wise/serialization": "1.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-session": "^1.19.0",
		"@types/node": "^24.13.3",
		"@types/supertest": "^7.2.1",
		"@types/ws": "^8.18.1",
		"rimraf": "^6.1.3",
		"supertest": "^7.2.2",
		"tsx": "^4.20.0",
		"vitest": "^3.0.0"
	}
}
