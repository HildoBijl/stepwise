{
	"extends": "../tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"strict": false,
		"strictNullChecks": true,
		"rootDir": "..",
		"types": ["vitest/globals", "node"]
	},
	"include": [
		"../src/**/*.ts",
		"../scripts/**/*.ts",
		"../migrations/**/*.ts",
		"**/*.ts"
	],
	"exclude": ["../dist", "../node_modules"]
}
