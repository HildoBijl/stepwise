{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@step-wise/*": ["../packages/*/dist"],
			"@graphql-tools/schema": ["../node_modules/@graphql-tools/schema/index.d.ts"],
			"graphql-scalars": ["../node_modules/graphql-scalars/index.d.ts"]
		},
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"rewriteRelativeImportExtensions": true,
		"target": "ES2022",
		"rootDir": ".",
		"outDir": "dist",
		"noEmit": false,
		"noEmitOnError": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"declaration": false,
		"composite": false,
		"types": ["node"]
	},
	"include": [
		"src/**/*.ts",
		"scripts/**/*.ts",
		"migrations/**/*.ts"
	],
	"exclude": [
		"dist",
		"node_modules",
		"tests"
	]
}
