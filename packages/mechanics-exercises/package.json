{
	"name": "@step-wise/mechanics-exercises",
	"version": "1.0.0",
	"private": true,
	"engines": {
		"node": ">=24.12.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"imports": {
		"#mechanicsExerciseBuilding/*": {
			"types": "./src/tools/exerciseBuilding/*.ts",
			"development": "./src/tools/exerciseBuilding/*.ts",
			"default": "./dist/tools/exerciseBuilding/*.js"
		},
		"#tools": {
			"types": "./src/tools/index.ts",
			"development": "./src/tools/index.ts",
			"default": "./dist/tools/index.js"
		},
		"#mechanicsValueTypes/*": {
			"types": "./src/tools/valueTypes/*.ts",
			"development": "./src/tools/valueTypes/*.ts",
			"default": "./dist/tools/valueTypes/*.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"watch": "tsc -b tsconfig.build.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@step-wise/cas": "1.0.0",
		"@step-wise/engineering-mechanics": "1.0.0",
		"@step-wise/exercise-bundling": "1.0.0",
		"@step-wise/exercise-grading": "1.0.0",
		"@step-wise/geometry": "1.0.0",
		"@step-wise/input-exercises": "1.0.0",
		"@step-wise/physics-core": "1.0.0",
		"@step-wise/js-utils": "1.0.0",
		"@step-wise/mathematics-value-types": "1.0.0",
		"@step-wise/physics-value-types": "1.0.0",
		"@step-wise/serialization": "1.0.0",
		"@step-wise/input-interpretation": "1.0.0",
		"@step-wise/value-equality": "1.0.0",
		"@step-wise/value-types": "1.0.0"
	},
	"devDependencies": {
		"vitest": "^3.0.0"
	}
}
