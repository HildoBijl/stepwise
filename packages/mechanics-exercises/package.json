{
	"name": "@step-wise/mechanics-exercises",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.12.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"imports": {
		"#mechanicsExerciseBuilding/*": {
			"types": "./src/private/exerciseBuilding/*.ts",
			"development": "./src/private/exerciseBuilding/*.ts",
			"default": "./dist/private/exerciseBuilding/*.js"
		},
		"#mechanicsValueTypes": {
			"types": "./src/private/valueTypes/index.ts",
			"development": "./src/private/valueTypes/index.ts",
			"default": "./dist/private/valueTypes/index.js"
		},
		"#mechanicsTools": {
			"types": "./src/private/tools/index.ts",
			"development": "./src/private/tools/index.ts",
			"default": "./dist/private/tools/index.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"watch": "tsc -b tsconfig.build.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@step-wise/cas": "^0.1.0",
		"@step-wise/engineering-mechanics": "^0.1.0",
		"@step-wise/exercise-bundling": "^0.1.0",
		"@step-wise/exercise-grading": "^0.1.0",
		"@step-wise/geometry": "^0.1.0",
		"@step-wise/input-exercises": "^0.1.0",
		"@step-wise/physics-core": "^0.1.0",
		"@step-wise/js-utils": "^0.1.0",
		"@step-wise/mathematics-value-types": "^0.1.0",
		"@step-wise/physics-value-types": "^0.1.0",
		"@step-wise/serialization": "^0.1.0",
		"@step-wise/input-interpretation": "^0.1.0",
		"@step-wise/value-equality": "^0.1.0",
		"@step-wise/value-types": "^0.1.0"
	},
	"devDependencies": {
		"vitest": "^3.0.0"
	}
}
