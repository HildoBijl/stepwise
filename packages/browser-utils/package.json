{
	"name": "@step-wise/browser-utils",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.12.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"test": "vitest run --configLoader runner --config vitest.config.ts",
		"watch": "tsc -b tsconfig.build.json --watch"
	},
	"dependencies": {
		"@step-wise/geometry": "^0.1.0"
	},
	"devDependencies": {
		"jsdom": "^30.0.0",
		"vitest": "^5.0.0"
	}
}
