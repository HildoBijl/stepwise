{
	"name": "@step-wise/cas",
	"version": "0.1.0",
	"description": "A computer algebra system for expressions, equations, simplification, evaluation, comparison, and differentiation.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HildoBijl/stepwise.git",
		"directory": "packages/cas"
	},
	"bugs": {
		"url": "https://github.com/HildoBijl/stepwise/issues"
	},
	"homepage": "https://github.com/HildoBijl/stepwise/tree/main/packages/cas#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"type": "module",
	"main": "./dist/index.js",
