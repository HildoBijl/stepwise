{
	"name": "@step-wise/form",
	"version": "0.1.0",
	"description": "Headless React form state, value conversion, validation, and submission infrastructure.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HildoBijl/stepwise.git",
		"directory": "packages/form"
	},
	"bugs": {
		"url": "https://github.com/HildoBijl/stepwise/issues"
	},
	"homepage": "https://github.com/HildoBijl/stepwise/tree/main/packages/form#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.15.0"
	},
