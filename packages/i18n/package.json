{
	"name": "@step-wise/i18n",
	"version": "0.1.0",
	"description": "Reusable React internationalization setup for Step-Wise applications.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HildoBijl/stepwise.git",
		"directory": "packages/i18n"
	},
	"bugs": {
		"url": "https://github.com/HildoBijl/stepwise/issues"
	},
	"homepage": "https://github.com/HildoBijl/stepwise/tree/main/packages/i18n#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.15.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./catalog": {
			"types": "./dist/catalog/index.d.ts",
			"development": "./src/catalog/index.ts",
			"import": "./dist/catalog/index.js"
		},
		"./locale": {
			"types": "./dist/locale.d.ts",
			"development": "./src/locale.ts",
			"import": "./dist/locale.js"
		},
		"./xliff": {
			"types": "./dist/xliff/index.d.ts",
			"development": "./src/xliff/index.ts",
			"import": "./dist/xliff/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"XLIFF.md"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"watch": "tsc -b tsconfig.build.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@step-wise/js-utils": "^0.1.2",
		"saxes": "^6.0.0"
	},
	"peerDependencies": {
		"react": "^19.2.0"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.3",
		"@types/react": "19.2.18",
		"jsdom": "^30.0.0",
		"react": "19.2.8",
		"vitest": "^5.0.0"
	}
}
