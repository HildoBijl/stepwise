{
	"name": "@step-wise/js-utils",
	"version": "0.1.0",
	"description": "Composable JavaScript and TypeScript utilities with explicit validation and predictable behavior.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HildoBijl/stepwise.git",
		"directory": "packages/js-utils"
	},
	"bugs": {
		"url": "https://github.com/HildoBijl/stepwise/issues"
	},
	"homepage": "https://github.com/HildoBijl/stepwise/tree/main/packages/js-utils#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=24.12.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"watch": "tsc -b tsconfig.build.json --watch"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"vitest": "^3.0.0"
	}
}
