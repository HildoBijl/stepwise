{
	"name": "@step-wise/mathematics-exercises",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=24.12.0"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"imports": {
		"#generationTools": {
			"types": "./src/generationTools.ts",
			"development": "./src/generationTools.ts",
			"default": "./dist/generationTools.js"
		},
		"#mathematicsExerciseBuilding": {
			"types": "./src/exerciseBuilding.ts",
			"development": "./src/exerciseBuilding.ts",
			"default": "./dist/exerciseBuilding.js"
		}
	},
	"scripts": {
		"build": "tsc -b tsconfig.build.json",
		"watch": "tsc -b tsconfig.build.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@step-wise/cas": "^0.1.0",
		"@step-wise/exercise-bundling": "^0.1.0",
		"@step-wise/exercise-definition": "^0.1.0",
		"@step-wise/exercise-grading": "^0.1.0",
		"@step-wise/input-exercises": "^0.1.0",
		"@step-wise/skill-setup": "^0.1.0",
		"@step-wise/js-utils": "^0.1.0",
		"@step-wise/value-types": "^0.1.0",
		"@step-wise/mathematics-value-types": "^0.1.0"
	},
	"devDependencies": {
		"vitest": "^3.0.0"
	}
}
