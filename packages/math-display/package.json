{
	"name": "@step-wise/math-display",
	"version": "0.1.0",
	"description": "React components and utilities for displaying mathematics with KaTeX.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HildoBijl/stepwise.git",
		"directory": "packages/math-display"
	},
	"bugs": {
		"url": "https://github.com/HildoBijl/stepwise/issues"
	},
